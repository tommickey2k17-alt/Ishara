# ==========================================
# SWASTHYA LOG - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port (default: 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Gemini AI API Key (Optional but recommended for intelligent symptom parsing & clinical reports)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/app/apikey)
# Supported variable names: GEMINI_API_KEY or GOOGLE_GENAI_API_KEY
GEMINI_API_KEY="your-gemini-api-key-here"

# Public Application URL (Optional, used for base URL and production canonical references)
APP_URL="http://localhost:3000"

